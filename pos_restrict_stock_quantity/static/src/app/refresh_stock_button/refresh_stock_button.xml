<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_restrict_stock_quantity.RefreshStockButton">
        <div class="control-button btn btn-light rounded-0 fw-bolder prsq-refresh-button"
             t-att-class="{'prsq-refreshing': isRefreshing}" t-on-click="onClick">
            <i class="fa fa-refresh" t-att-class="{'fa-spin': isRefreshing}" role="img"
               aria-label="Refresh Stock" title="Refresh Stock"/>
            Refresh Stock
        </div>
    </t>

</templates>
