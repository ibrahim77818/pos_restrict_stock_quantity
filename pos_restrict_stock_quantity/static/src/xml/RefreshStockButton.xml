<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_restrict_stock_quantity.RefreshStockButton" owl="1">
        <div class="control-button prsq-refresh-button" t-att-class="{'prsq-refreshing': isRefreshing}">
            <i class="fa fa-refresh" t-att-class="{'fa-spin': isRefreshing}" role="img"
               aria-label="Refresh Stock" title="Refresh Stock"/>
