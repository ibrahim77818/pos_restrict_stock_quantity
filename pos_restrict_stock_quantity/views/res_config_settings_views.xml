<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_prsq" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.prsq</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']" position="after">
                <block title="Stock Visibility &amp; Restriction" id="prsq_settings_section">

                    <setting id="prsq_show_stock_setting" string="Stock Badges on Products"
                             help="Show the on-hand quantity on product cards">
                        <field name="pos_prsq_show_stock"/>
                        <div class="content-group mt8">
                            <span class="badge rounded-pill text-bg-success">in stock</span>
                            <span class="badge rounded-pill text-bg-danger ms-1">out of stock</span>
                        </div>
                        <div class="content-group mt8">
                            <field name="pos_prsq_show_forecast" class="w-auto"/>
                            <label for="pos_prsq_show_forecast" class="o_light_label ms-1"
                                   string="Also show the forecasted quantity"/>
                            <span class="badge rounded-pill text-bg-primary ms-1">forecast</span>
                        </div>
                    </setting>

                    <setting id="prsq_restrict_setting" string="Restrict Out-of-Stock Sales"
                             help="Cashiers cannot sell more than the available quantity of storable products">
                        <field name="pos_prsq_restrict_out_of_stock"/>
                        <div class="content-group mt16" invisible="not pos_prsq_restrict_out_of_stock">
                            <div class="row">
                                <label for="pos_prsq_restriction_basis" string="Available Quantity"
                                       class="col-lg-4 o_light_label"/>
                                <field name="pos_prsq_restriction_basis"
                                       required="pos_prsq_restrict_out_of_stock"/>
                            </div>
                            <div class="row">
                                <label for="pos_prsq_restriction_mode" string="On Shortage"
                                       class="col-lg-4 o_light_label"/>
                                <field name="pos_prsq_restriction_mode"
                                       required="pos_prsq_restrict_out_of_stock"/>
                            </div>
                            <div class="mt8">
                                <button name="action_prsq_open_exemption_wizard" type="object"
                                        class="btn-link p-0" icon="fa-unlock">
                                    Manage Exempted Products
                                </button>
                                <span class="ms-1 badge rounded-pill text-bg-secondary">
                                    <field name="pos_prsq_exempt_count"/>
                                </span>
                            </div>
                            <div class="mt8">
                                <field name="pos_prsq_exempt_product_ids" widget="many2many_tags"
                                       options="{'no_create': True}"
                                       placeholder="Exempted products..."/>
                            </div>
                        </div>
                    </setting>

                    <setting id="prsq_location_setting" string="Stock Source"
                             help="Location used to compute quantities for this POS (linked to its Operation Type and Warehouse)">
                        <div class="content-group">
                            <field name="pos_prsq_location_scope" widget="radio"/>
                            <div class="row" invisible="pos_prsq_location_scope != 'warehouse'">
                                <label for="pos_prsq_warehouse_id" string="Warehouse"
                                       class="col-lg-4 o_light_label"/>
                                <field name="pos_prsq_warehouse_id" options="{'no_create': True}"
                                       required="pos_prsq_location_scope == 'warehouse'"/>
                            </div>
                            <div class="row" invisible="pos_prsq_location_scope != 'location'">
                                <label for="pos_prsq_location_id" string="Location"
                                       class="col-lg-4 o_light_label"/>
                                <field name="pos_prsq_location_id" options="{'no_create': True}"
                                       domain="[('usage', 'in', ('internal', 'view')), ('company_id', 'in', (company_id, False))]"
                                       required="pos_prsq_location_scope == 'location'"/>
                            </div>
                            <div class="row">
                                <label for="pos_prsq_stock_location_id" string="Effective Location"
                                       class="col-lg-4 o_light_label"/>
                                <field name="pos_prsq_stock_location_id" options="{'no_open': True}"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="prsq_refresh_setting" string="Stock Auto Refresh"
                             help="Quantities are embedded when the POS loads and refreshed after each synced order. Optionally reload them every N minutes (0 = off).">
                        <div class="content-group">
                            <field name="pos_prsq_refresh_interval" class="w-auto"/> minutes
                        </div>
                    </setting>

                </block>
            </xpath>
        </field>
    </record>

</odoo>
