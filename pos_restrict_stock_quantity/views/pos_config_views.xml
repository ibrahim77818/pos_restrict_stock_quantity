<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Stock visibility & restriction directly on the POS configuration record -->
    <record id="pos_config_view_form_inherit_prsq" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.prsq</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']/.." position="after">
                <div invisible="context.get('pos_config_create_mode', False)" id="prsq_config_block">
                    <field name="company_id" invisible="1"/>
                    <h2 class="mt-4">Stock Visibility &amp; Restriction</h2>
                    <div class="row mt16 o_settings_container">
                        <setting id="prsq_display_box" string="Show Stock on Products"
                                 help="Green / red on-hand badge on POS product cards">
                            <field name="prsq_show_stock"/>
                            <div class="content-group mt8">
                                <field name="prsq_show_forecast" class="w-auto"/>
                                <label for="prsq_show_forecast" class="o_light_label ms-1"/>
                            </div>
                        </setting>
                        <setting id="prsq_restrict_box" string="Restrict Out-of-Stock Sales"
                                 help="Do not sell more than the available quantity">
                            <field name="prsq_restrict_out_of_stock"/>
                            <div class="content-group mt8" invisible="not prsq_restrict_out_of_stock">
                                <div class="row">
                                    <label for="prsq_restriction_basis" class="col-lg-5 o_light_label"/>
                                    <field name="prsq_restriction_basis"/>
                                </div>
                                <div class="row">
                                    <label for="prsq_restriction_mode" class="col-lg-5 o_light_label"/>
                                    <field name="prsq_restriction_mode"/>
                                </div>
                                <div class="mt8">
                                    <button name="action_prsq_open_exemption_wizard" type="object"
                                            class="btn-link p-0" icon="fa-unlock">
                                        Manage Exempted Products
                                    </button>
                                    <span class="ms-1 badge rounded-pill text-bg-secondary">
                                        <field name="prsq_exempt_count"/>
                                    </span>
                                </div>
                            </div>
                        </setting>
                        <setting id="prsq_source_box" string="Compute Stock From"
                                 help="Where POS quantities are computed">
                            <div class="content-group">
                                <div class="text-muted mb8">
                                    Operation Type: <field name="picking_type_id" class="d-inline" readonly="1" options="{'no_open': True}"/>
                                </div>
                                <field name="prsq_location_scope" widget="radio"/>
                                <div class="row" invisible="prsq_location_scope != 'warehouse'">
                                    <label for="prsq_warehouse_id" class="col-lg-5 o_light_label"/>
                                    <field name="prsq_warehouse_id" options="{'no_create': True}"
                                           required="prsq_location_scope == 'warehouse'"/>
                                </div>
                                <div class="row" invisible="prsq_location_scope != 'location'">
                                    <label for="prsq_location_id" class="col-lg-5 o_light_label"/>
                                    <field name="prsq_location_id" options="{'no_create': True}"
                                           required="prsq_location_scope == 'location'"/>
                                </div>
                                <div class="row">
                                    <label for="prsq_stock_location_id" class="col-lg-5 o_light_label"/>
                                    <field name="prsq_stock_location_id" options="{'no_open': True}"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="prsq_refresh_box" string="Auto Refresh (minutes)"
                                 help="Background stock refresh while the POS is open (0 = off)">
                            <field name="prsq_refresh_interval" class="w-auto"/>
                        </setting>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
